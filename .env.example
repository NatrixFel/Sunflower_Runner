# Copy to .env (gitignored) and fill in. Leave a line blank if that tree is absent.

# Deposit next to this repo (VCF / NPZ call sets). Default is ../04_Депозит
# SUNFLOWER_DEPOSIT=

# Script-generated tables. Default is ./outputs
# SUNFLOWER_OUT=

# Undeposited inputs: primary Excel, var1/var2 VCF. Relative names under this root
# are the original working-tree folders (FINAL_rebutS/, 1_данные из вниимка/,
# 6_новые данные_ответы + исходники +vcf/). Leave blank if those files are absent.
SUNFLOWER_WORK=

# Calling pipeline root: raw_vcf/, raw_vcf_merged/, merged BAM
SUNFLOWER_CALLING=

# Nextflow pipeline that ran the alignment
CHOCALLATE=

# Reference FASTA (HanXRQr2.0-SUNRISE.fna.gz)
SUNFLOWER_REF=
# bowtie2 index directory
SUNFLOWER_REF_INDEX=
